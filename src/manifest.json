{
  "manifest_version": 3,
  "name": "Odoo Ticket Markdown",
  "version": "0.1.0",
  "description": "Download the current Odoo task title and description as Markdown.",
  "browser_specific_settings": {
    "gecko": {
      "id": "odoo-ticket-markdown@avantys.local",
      "strict_min_version": "142.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "permissions": ["downloads"],
  "host_permissions": ["https://odoo.samuu.com.py/*"],
  "background": { "scripts": ["background.js"] },
  "content_scripts": [{
    "matches": ["https://odoo.samuu.com.py/*"],
    "js": ["content.js"],
    "css": ["content.css"],
    "run_at": "document_idle"
  }]
}
